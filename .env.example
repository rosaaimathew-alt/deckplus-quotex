# QuoteX (rows architecture) — environment variables.
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Browser (Vite inlines VITE_* at build time). Use the project URL + anon key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# API functions + seed scripts. Use the service_role key; it never reaches the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ── Company ──────────────────────────────────────────────────────────────────
# Name printed in customer emails (proposal, follow-up, payment reminder, close-out).
COMPANY_NAME=Deck Plus
# Fallback host used in signing / tracked-proposal links when no request host is present.
PUBLIC_HOST=quotex.example.com

# ── Vercel KV (required for signing links, tracked proposal links, inbox, Google tokens)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── AI (one of these; /api/ai-chat picks Groq, then Gemini, then Anthropic) ──
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
# Option A: connect a Google account in Settings (uses GOOGLE_CLIENT_ID/SECRET below).
# Option B: shared Gmail SMTP fallback (an app password, not the account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Inbound-email webhook (Resend / Postmark). Endpoint is disabled until this is set.
INBOUND_WEBHOOK_SECRET=

# ── Google OAuth (Drive backup/upload, Gmail send + inbox sync) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Seed scripts only (scripts/seed-users.mjs, scripts/seed-new-org.mjs) ─────
# ORG_NAME="Deck Plus"
# SEED_PASSWORD='ChangeMe123!'
# SEED_EMAIL_DOMAIN=deckplus.example
# CONTRACT_PREFIX=DP
